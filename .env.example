# Copy to .env and fill in the three secrets marked REQUIRED.
# Every variable below is read by both the gateway and the workers unless noted.

# ---------------------------------------------------------------- LLM (REQUIRED)
ANTHROPIC_API_KEY=                 # REQUIRED - console.anthropic.com -> API keys
LLM_MODEL=claude-haiku-5-5         # any Claude model id, e.g. claude-sonnet-5-5
LLM_EFFORT=medium                  # low | medium | high
LLM_RPM=40                         # global requests/minute budget shared by ALL workers
LLM_ITPM=40000                     # global input-tokens/minute budget shared by ALL workers
LLM_CHUNK_TOKENS=60000             # transcripts longer than this are chunked + merged
LLM_MAX_FRAMES=8                   # max key frames the LLM may flag per video
FRAME_VISION_CHECK=true            # re-caption each captured frame from the actual pixels

# ---------------------------------------------------------------- Notion OAuth (REQUIRED)
NOTION_CLIENT_ID=                  # REQUIRED - Notion public (OAuth) connection
NOTION_CLIENT_SECRET=              # REQUIRED
NOTION_REDIRECT_URI=https://cfajbkllcohlnhfahfccoiopccagglon.chromiumapp.org/notion
NOTION_RPS=2.5                     # global Notion requests/second (Notion limit is ~3)
DEFAULT_NOTION_PAGE_TITLE=Video Notes

# ---------------------------------------------------------------- Security
# Fernet key used to encrypt the Notion token inside queued messages.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=                     # REQUIRED

# ---------------------------------------------------------------- Infrastructure
DATABASE_URL=postgresql+psycopg://notes:notes@postgres:5432/notes
RABBITMQ_URL=amqp://notes:notes@rabbitmq:5672/%2F
REDIS_URL=redis://redis:6379/0
PUBLIC_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------- Videos without captions
ASR_FALLBACK=true                  # transcribe the audio locally (Whisper) when a video has no captions
WHISPER_MODEL=base                 # tiny | base | small (base is baked into the worker image)
WHISPER_THREADS=4
# Optional: Netscape cookies.txt exported from a logged-in YouTube session, placed in ./cookies/
# Helps if YouTube starts asking this IP to "confirm you're not a bot".
YOUTUBE_COOKIES_FILE=/run/cookies/youtube.txt

# ---------------------------------------------------------------- Retries / backoff
MAX_ATTEMPTS=5                     # attempts before a job is DEAD_LETTERED
BACKOFF_SECONDS=10,30,90,90        # delay before retry #1, #2, ... (last value repeats)
YOUTUBE_RPS=1                      # global YouTube metadata/transcript requests/second

# ---------------------------------------------------------------- Limits
MAX_VIDEO_SECONDS=1200             # Constraint A: 20 minutes
FRAME_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------- Demo / grading
ENABLE_DEBUG_ENDPOINTS=true        # exposes POST /debug/chaos for fault injection
LOG_LEVEL=INFO
